<Window x:Class="CurveEditor.DevicesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Devices" Width="900" Height="480" MinWidth="640" MinHeight="320"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <DockPanel Margin="14">
        <StackPanel DockPanel.Dock="Top">
            <TextBlock Text="Defaults for every device" FontWeight="SemiBold" Margin="0,0,0,6" />
            <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                <CheckBox Content="Disable by default" IsChecked="{Binding DefaultDisable}" VerticalAlignment="Center" Margin="0,0,18,0" />
                <TextBlock Text="DPI" VerticalAlignment="Center" Margin="0,0,6,0" />
                <TextBox Text="{Binding DefaultDpi}" Width="70" Margin="0,0,18,0"
                         ToolTip="Normalizes input speed to inches/second (0 = off)" />
                <TextBlock Text="Polling rate (Hz)" VerticalAlignment="Center" Margin="0,0,6,0" />
                <TextBox Text="{Binding DefaultPollingRate}" Width="70"
                         ToolTip="0 = measure automatically" />
            </StackPanel>
            <TextBlock Text="Connected devices" FontWeight="SemiBold" Margin="0,0,0,6" />
            <TextBlock Text="Tick Override to give a device its own DPI, polling rate or profile. Devices without an override (or with no profile chosen) use the first profile."
                       Foreground="#5F6670" TextWrapping="Wrap" Margin="0,0,0,8" />
        </StackPanel>

        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="OK" IsDefault="True" MinWidth="80" Click="OnOk" />
            <Button Content="Cancel" IsCancel="True" MinWidth="80" Margin="0" />
        </StackPanel>

        <DataGrid ItemsSource="{Binding Rows}" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False"
                  HeadersVisibility="Column" GridLinesVisibility="Horizontal" SelectionMode="Single">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Device" Binding="{Binding Name}" IsReadOnly="True" Width="2*" />
                <DataGridTextColumn Header="ID" Binding="{Binding Id}" IsReadOnly="True" Width="2*" />
                <DataGridCheckBoxColumn Header="Override" Binding="{Binding Override, UpdateSourceTrigger=PropertyChanged}" Width="Auto" />
                <DataGridCheckBoxColumn Header="Disable" Binding="{Binding Disable, UpdateSourceTrigger=PropertyChanged}" Width="Auto" />
                <DataGridTextColumn Header="DPI" Binding="{Binding Dpi}" Width="70" />
                <DataGridTextColumn Header="Polling rate" Binding="{Binding PollingRate}" Width="90" />
                <DataGridTemplateColumn Header="Profile" Width="*">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <ComboBox ItemsSource="{Binding DataContext.ProfileNames, RelativeSource={RelativeSource AncestorType=Window}}"
                                      SelectedItem="{Binding Profile, UpdateSourceTrigger=PropertyChanged}"
                                      IsEnabled="{Binding Override}" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>
    </DockPanel>
</Window>
