<Window x:Class="CurveEditor.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="clr-namespace:CurveEditor.Controls"
        xmlns:vm="clr-namespace:CurveEditor.ViewModels"
        Title="Raw Accel — Curve Editor"
        Icon="mouse.ico"
        Width="1280" Height="800" MinWidth="900" MinHeight="560"
        WindowStartupLocation="CenterScreen"
        UseLayoutRounding="True">

    <Window.InputBindings>
        <KeyBinding Key="Z" Modifiers="Control" Command="{Binding UndoCommand}" />
        <KeyBinding Key="Y" Modifiers="Control" Command="{Binding RedoCommand}" />
        <KeyBinding Key="Z" Modifiers="Control+Shift" Command="{Binding RedoCommand}" />
        <KeyBinding Key="S" Modifiers="Control" Command="{Binding ApplyCommand}" />
    </Window.InputBindings>

    <DockPanel>
        <!-- top bar -->
        <Border DockPanel.Dock="Top" Background="{StaticResource PanelBrush}" BorderBrush="#DADDE2" BorderThickness="0,0,0,1" Padding="10,8">
            <DockPanel LastChildFill="False">
                <TextBlock Text="Profile" VerticalAlignment="Center" Margin="0,0,8,0" />
                <ComboBox Width="190" ItemsSource="{Binding Profiles}" SelectedItem="{Binding SelectedProfile}" DisplayMemberPath="Name" Margin="0,0,6,0" />
                <Button Content="New…" Click="OnAddProfile" ToolTip="Add a profile (copy of the current one)" />
                <Button Content="Rename…" Click="OnRenameProfile" />
                <Button Content="Delete" Command="{Binding DeleteProfileCommand}" />
                <Button Content="Devices…" Click="OnDevices" Margin="12,0,6,0" ToolTip="Per-device DPI, polling rate, disable, and profile assignment" />

                <Button DockPanel.Dock="Right" Content="Apply" Style="{StaticResource PrimaryButton}" Command="{Binding ApplyCommand}" Margin="0" MinWidth="90" ToolTip="Write settings.json and send the settings to the driver (Ctrl+S)" />
                <Button DockPanel.Dock="Right" Content="Revert" Command="{Binding RevertCommand}" ToolTip="Go back to the last applied settings for this profile" />
                <Button DockPanel.Dock="Right" Content="Redo" Command="{Binding RedoCommand}" ToolTip="Ctrl+Y" />
                <Button DockPanel.Dock="Right" Content="Undo" Command="{Binding UndoCommand}" ToolTip="Ctrl+Z" />
            </DockPanel>
        </Border>

        <!-- status bar -->
        <Border DockPanel.Dock="Bottom" Background="{StaticResource PanelBrush}" BorderBrush="#DADDE2" BorderThickness="0,1,0,0" Padding="10,4">
            <StackPanel>
                <TextBlock Text="{Binding SelectionText}" FontFamily="Consolas" FontSize="12" TextTrimming="CharacterEllipsis" />
                <DockPanel>
                    <TextBlock DockPanel.Dock="Right" Text="{Binding DirtyText}" Foreground="{StaticResource SubtleTextBrush}" Margin="12,0,0,0" />
                    <TextBlock Text="{Binding Status}" Foreground="{StaticResource SubtleTextBrush}" TextTrimming="CharacterEllipsis" />
                </DockPanel>
            </StackPanel>
        </Border>

        <!-- side panel -->
        <Border DockPanel.Dock="Right" Width="320" Background="White" BorderBrush="#DADDE2" BorderThickness="1,0,0,0">
            <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="14,4,14,14">
                <StackPanel>
                    <TextBlock Text="Curve" Style="{StaticResource SectionHeader}" />

                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8" Visibility="{Binding Separate, Converter={StaticResource BoolToVisibility}}">
                        <RadioButton Content="Horizontal (X)" IsChecked="{Binding EditingY, Converter={StaticResource Not}}" Margin="0,0,14,0" />
                        <RadioButton Content="Vertical (Y)" IsChecked="{Binding EditingY}" />
                    </StackPanel>

                    <ComboBox ItemsSource="{Binding Modes}" SelectedItem="{Binding SelectedMode}">
                        <ComboBox.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:ModeOption}">
                                <TextBlock Text="{Binding Name}" ToolTip="{Binding Description}" />
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                    <TextBlock Text="{Binding SelectedMode.Description}" Style="{StaticResource Hint}" Margin="0,4,0,8" />

                    <StackPanel Visibility="{Binding HasGainOption, Converter={StaticResource BoolToVisibility}}" Margin="0,0,0,6">
                        <RadioButton Content="{Binding GainLabel}" IsChecked="{Binding Gain}" Margin="0,0,0,3"
                                     ToolTip="Gain: the curve describes how output speed grows (smoother, recommended)" />
                        <RadioButton Content="{Binding LegacyLabel}" IsChecked="{Binding Legacy}"
                                     ToolTip="Legacy: the curve is applied directly as a sensitivity multiplier" />
                    </StackPanel>

                    <CheckBox Content="Cap" IsChecked="{Binding Capped}" Margin="0,2,0,6"
                              Visibility="{Binding CapVisible, Converter={StaticResource BoolToVisibility}}"
                              ToolTip="Stop the curve from growing past the cap handle" />

                    <ItemsControl ItemsSource="{Binding Parameters}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:ParameterField}">
                                <Grid Margin="0,2" ToolTip="{Binding Tooltip}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="120" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="62" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding Label}" Style="{StaticResource FieldLabel}" />
                                    <c:NumericField Grid.Column="1" Value="{Binding Value, Mode=TwoWay, UpdateSourceTrigger=Explicit}" Minimum="{Binding Minimum}" Maximum="{Binding Maximum}" />
                                    <TextBlock Grid.Column="2" Text="{Binding Delta}" Style="{StaticResource Hint}" VerticalAlignment="Center" Margin="6,0,0,0" TextWrapping="NoWrap" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <StackPanel Visibility="{Binding IsLookup, Converter={StaticResource BoolToVisibility}}">
                        <CheckBox Content="Smooth curve through points" IsChecked="{Binding SmoothLut}" Margin="0,2,0,4"
                                  ToolTip="Draw a smooth, overshoot-free curve through the points (sampled into the driver's table). Off: straight lines between points." />
                        <TextBlock Text="{Binding PointCountText}" Style="{StaticResource Hint}" />
                        <TextBlock Text="Double-click the chart to add a point, drag to move, right-click or Delete to remove. Beyond the last point the driver continues the last segment's slope." Style="{StaticResource Hint}" Margin="0,4,0,6" />
                        <TextBlock Text="Points (speed,sensitivity;…)" Style="{StaticResource Hint}" />
                        <TextBox Text="{Binding LutText, UpdateSourceTrigger=LostFocus}" TextWrapping="Wrap" AcceptsReturn="False" MaxHeight="90" VerticalScrollBarVisibility="Auto" FontFamily="Consolas" FontSize="11"
                                 ToolTip="Paste or edit points, then click elsewhere to apply" />
                    </StackPanel>

                    <Button Content="Convert to custom curve" Command="{Binding ConvertToCustomCommand}" Margin="0,10,0,0" HorizontalAlignment="Left"
                            Visibility="{Binding IsParametric, Converter={StaticResource BoolToVisibility}}"
                            ToolTip="Turn this curve into free-form points you can shape any way you like" />

                    <TextBlock Text="Sensitivity" Style="{StaticResource SectionHeader}" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="120" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition />
                        </Grid.RowDefinitions>
                        <TextBlock Text="Sensitivity" Style="{StaticResource FieldLabel}" />
                        <c:NumericField Grid.Column="1" Value="{Binding Sensitivity, UpdateSourceTrigger=Explicit}" Margin="0,2" ToolTip="Base sensitivity multiplier (output DPI / 1000)" />
                        <TextBlock Grid.Row="1" Text="Y/X ratio" Style="{StaticResource FieldLabel}" />
                        <c:NumericField Grid.Row="1" Grid.Column="1" Value="{Binding YXRatio, UpdateSourceTrigger=Explicit}" Margin="0,2" ToolTip="Vertical sensitivity multiplier" />
                        <TextBlock Grid.Row="2" Text="Rotation (°)" Style="{StaticResource FieldLabel}" />
                        <c:NumericField Grid.Row="2" Grid.Column="1" Value="{Binding Rotation, UpdateSourceTrigger=Explicit}" Margin="0,2" />
                        <CheckBox Grid.Row="3" Grid.ColumnSpan="2" Content="Separate horizontal / vertical curves" IsChecked="{Binding Separate}" Margin="0,6,0,0"
                                  ToolTip="By-component mode: X and Y movement each use their own curve" />
                    </Grid>

                    <Expander Header="Advanced" Margin="0,12,0,0">
                        <Grid Margin="0,6,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="150" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition />
                            </Grid.RowDefinitions>
                            <TextBlock Text="Angle snap (°)" Style="{StaticResource FieldLabel}" />
                            <c:NumericField Grid.Column="1" Value="{Binding Snap, UpdateSourceTrigger=Explicit}" Minimum="0" Maximum="45" Margin="0,2" />
                            <TextBlock Grid.Row="1" Text="Input speed cap" Style="{StaticResource FieldLabel}" />
                            <c:NumericField Grid.Row="1" Grid.Column="1" Value="{Binding SpeedCap, UpdateSourceTrigger=Explicit}" Minimum="0" Margin="0,2" ToolTip="0 = no cap" />
                            <TextBlock Grid.Row="2" Text="Left/right ratio" Style="{StaticResource FieldLabel}" />
                            <c:NumericField Grid.Row="2" Grid.Column="1" Value="{Binding LRRatio, UpdateSourceTrigger=Explicit}" Margin="0,2" ToolTip="Sensitivity multiplier for leftward movement" />
                            <TextBlock Grid.Row="3" Text="Up/down ratio" Style="{StaticResource FieldLabel}" />
                            <c:NumericField Grid.Row="3" Grid.Column="1" Value="{Binding UDRatio, UpdateSourceTrigger=Explicit}" Margin="0,2" ToolTip="Sensitivity multiplier for upward movement" />
                            <TextBlock Grid.Row="4" Text="Domain weight X" Style="{StaticResource FieldLabel}" />
                            <c:NumericField Grid.Row="4" Grid.Column="1" Value="{Binding DomainX, UpdateSourceTrigger=Explicit}" Margin="0,2" ToolTip="Stretches input speed for horizontal movement" />
                            <TextBlock Grid.Row="5" Text="Domain weight Y" Style="{StaticResource FieldLabel}" />
                            <c:NumericField Grid.Row="5" Grid.Column="1" Value="{Binding DomainY, UpdateSourceTrigger=Explicit}" Margin="0,2" />
                            <TextBlock Grid.Row="6" Text="Range weight X" Style="{StaticResource FieldLabel}" />
                            <c:NumericField Grid.Row="6" Grid.Column="1" Value="{Binding RangeX, UpdateSourceTrigger=Explicit}" Margin="0,2" ToolTip="Scales how much of the curve applies to horizontal movement" />
                            <TextBlock Grid.Row="7" Text="Range weight Y" Style="{StaticResource FieldLabel}" />
                            <c:NumericField Grid.Row="7" Grid.Column="1" Value="{Binding RangeY, UpdateSourceTrigger=Explicit}" Margin="0,2" />
                            <TextBlock Grid.Row="8" Text="Lp norm" Style="{StaticResource FieldLabel}" />
                            <c:NumericField Grid.Row="8" Grid.Column="1" Value="{Binding LpNorm, UpdateSourceTrigger=Explicit}" Margin="0,2" ToolTip="How X and Y combine into speed (2 = Euclidean)" />
                            <TextBlock Grid.Row="9" Text="Input smoothing (ms)" Style="{StaticResource FieldLabel}" />
                            <c:NumericField Grid.Row="9" Grid.Column="1" Value="{Binding InputSmoothHalflife, UpdateSourceTrigger=Explicit}" Minimum="0" Margin="0,2" ToolTip="Half-life of input speed smoothing" />
                            <TextBlock Grid.Row="10" Text="Scale smoothing (ms)" Style="{StaticResource FieldLabel}" />
                            <c:NumericField Grid.Row="10" Grid.Column="1" Value="{Binding ScaleSmoothHalflife, UpdateSourceTrigger=Explicit}" Minimum="0" Margin="0,2" />
                            <TextBlock Grid.Row="11" Text="Output smoothing (ms)" Style="{StaticResource FieldLabel}" />
                            <c:NumericField Grid.Row="11" Grid.Column="1" Value="{Binding OutputSmoothHalflife, UpdateSourceTrigger=Explicit}" Minimum="0" Margin="0,2" />
                        </Grid>
                    </Expander>

                    <Expander Header="Precision controls" Margin="0,10,0,0" IsExpanded="True">
                        <TextBlock Style="{StaticResource Hint}" FontSize="11.5" Margin="0,6,0,0" LineHeight="17">
                            <Run FontWeight="SemiBold" Text="Zoom" />
                            <Run Text="  wheel at cursor · Shift+wheel: speed axis · Ctrl+wheel: sensitivity axis · right-drag: box zoom · F: fit · Home: reset" />
                            <LineBreak />
                            <Run FontWeight="SemiBold" Text="Pan" />
                            <Run Text="  drag empty space (left or middle button)" />
                            <LineBreak />
                            <Run FontWeight="SemiBold" Text="Fine drag" />
                            <Run Text="  hold Shift (1/10 speed) or Shift+Ctrl (1/100) · Alt locks to one axis" />
                            <LineBreak />
                            <Run FontWeight="SemiBold" Text="Nudge" />
                            <Run Text="  select a handle, then arrow keys · Shift: 10× finer · Ctrl: 10× coarser · Tab: next handle" />
                            <LineBreak />
                            <Run FontWeight="SemiBold" Text="Exact values" />
                            <Run Text="  type in the fields, or scroll/arrow inside a field (Shift finer, Ctrl coarser)" />
                        </TextBlock>
                    </Expander>
                </StackPanel>
            </ScrollViewer>
        </Border>

        <!-- chart -->
        <DockPanel>
            <Border DockPanel.Dock="Top" Background="#1B1D21" Padding="10,6">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Show" Foreground="#C9CDD4" VerticalAlignment="Center" Margin="0,0,8,0" />
                    <RadioButton Content="Sensitivity" Foreground="#C9CDD4" GroupName="kind" Margin="0,0,10,0" VerticalAlignment="Center" Checked="OnKindSensitivity" IsChecked="True" />
                    <RadioButton Content="Velocity" Foreground="#C9CDD4" GroupName="kind" Margin="0,0,10,0" VerticalAlignment="Center" Checked="OnKindVelocity" />
                    <RadioButton Content="Gain" Foreground="#C9CDD4" GroupName="kind" Margin="0,0,18,0" VerticalAlignment="Center" Checked="OnKindGain" />
                    <CheckBox Content="Log speed axis" Foreground="#C9CDD4" IsChecked="{Binding LogX}" VerticalAlignment="Center" Margin="0,0,18,0" />
                    <Button Content="Fit (F)" Command="{Binding FitCommand}" />
                    <Button Content="Reset view (Home)" Command="{Binding ResetViewCommand}" />
                    <TextBlock Text="  ─ current   ┄ applied   ● live mouse" Foreground="#8A9099" VerticalAlignment="Center" Margin="10,0,0,0" />
                </StackPanel>
            </Border>
            <c:CurveCanvas x:Name="Chart" />
        </DockPanel>
    </DockPanel>
</Window>
